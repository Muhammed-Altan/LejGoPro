// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  features    String   // Store as comma-separated string
  popular     Boolean  @default(false)
  dailyPrice  Int     // Price per day for bookings under 7 days
  weeklyPrice Int     // Price for exactly 7 days
  twoWeekPrice Int    // Price for exactly 14 days
  quantity    Int     @default(1) // Number of units available for this product
  cameras     Camera[]
}

model Accessory {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  price       Int
  quantity    Int     @default(1)
  instances   AccessoryInstance[]
}

model AccessoryInstance {
  id          Int      @id @default(autoincrement())
  accessory   Accessory @relation(fields: [accessoryId], references: [id])
  accessoryId Int
  bookings    AccessoryBooking[]
}

model AccessoryBooking {
  id              Int      @id @default(autoincrement())
  accessoryInstance AccessoryInstance @relation(fields: [accessoryInstanceId], references: [id])
  accessoryInstanceId Int
  startDate       DateTime
  endDate         DateTime
  customerName    String?
  status          String? @default("Booked")
}

model Camera {
  id           Int      @id @default(autoincrement())
  product      Product  @relation(fields: [productId], references: [id])
  productId    Int
  name         String?  // Make name optional
  dailyPrice   Int
  weeklyPrice  Int
  twoWeekPrice Int
  bookings     Booking[]
}

model Booking {
  id        Int      @id @default(autoincrement())
  camera    Camera   @relation(fields: [cameraId], references: [id])
  cameraId  Int
  cameraName String?
  productName String?
  startDate DateTime
  endDate   DateTime
  // Add user info if needed
}
