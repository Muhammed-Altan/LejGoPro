// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  features    String   // Store as comma-separated string
  popular     Boolean  @default(false)
  dailyPrice  Int     // Price per day for bookings under 7 days
  weeklyPrice Int     // Price for exactly 7 days
  twoWeekPrice Int    // Price for exactly 14 days
  quantity    Int     @default(1) // Number of units available for this product
  cameras     Camera[]
}

model Accessory {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  price       Int
}

model Camera {
  id           Int      @id @default(autoincrement())
  product      Product  @relation(fields: [productId], references: [id])
  productId    Int
  name         String?  // Make name optional
  dailyPrice   Int
  weeklyPrice  Int
  twoWeekPrice Int
  bookings     Booking[]
}

model Booking {
  id            Int      @id @default(autoincrement())
  camera        Camera   @relation(fields: [cameraId], references: [id])
  cameraId      Int
  cameraName    String?
  productName   String?
  startDate     DateTime
  endDate       DateTime

  // DeliveryStep.vue fields
  fullName      String
  phone         String
  email         String
  address       String
  apartment     String?   // Optional
  postalCode    String
  city          String

  // BasketView.vue fields
  accessoryIds  Int[]     // Array of Accessory IDs

  // Price
  totalPrice    Int

  // Add user info if needed
}
